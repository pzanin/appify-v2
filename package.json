{
  "name": "appify",
  "private": true,
  "main": "dist-electron/main.js",
  "version": "0.9.1",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=127.0.0.1",
    "build": "npm run build:pwa && vite build",
    "build:pwa": "cross-env VITE_BUILD_TARGET=pwa vite build --outDir dist-pwa",
    "postbuild:pwa": "node scripts/copy-pwa-template.mjs",
    "build:app": "npm run build && electron-builder --win nsis",
    "build:win": "npm run build:app",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "security:hooks": "git config core.hooksPath .githooks",
    "predev": "npm run build:pwa",
    "test:interactive": "npm run build && node scripts/test-interactive-electron.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^4.7.0",
    "dompurify": "^3.4.16",
    "file-saver": "^2.0.5",
    "i18next": "^26.1.0",
    "json5": "2.2.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-i18next": "^17.0.7",
    "tailwindcss": "^4.1.14",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/file-saver": "^2.0.7",
    "@types/jszip": "^3.4.0",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "electron": "^42.11.10",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.2",
    "typescript": "~5.8.2",
    "vite": "^6.4.3",
    "vite-plugin-electron": "^0.29.1"
  },
  "build": {
    "appId": "com.pzanin.appify",
    "productName": "Appify",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "Appify-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Appify",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}

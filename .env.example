# Apenas configuração local. Nunca coloque chaves privadas em variáveis VITE_*.
# O renderer não recebe variáveis .env; VITE_BUILD_TARGET é definido pelo build.
# Backend opcional do PWA: configure URL e chave pública pelo editor do Appify.
# Nunca use service_role, sb_secret_ ou tokens pessoais como chave pública.

# Diretório dos projetos locais (opcional, usado só pelo processo principal):
APPIFY_DATA_DIR=
